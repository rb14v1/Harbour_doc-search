# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres + pgvector) ---
POSTGRES_DB=doc_search
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Postgres/pgvector aren't
# available, e.g. on a bare dev machine with no Postgres install. Never set
# this in docker-compose/production. See backend/config/settings/base.py
# and backend/apps/common/embedding_field.py.
USE_SQLITE=False

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- AI / embeddings (backend/apps/common/ai.py) ---
# Leave OPENAI_API_KEY unset to run the whole app in fully-functional STUB
# mode: deterministic fake embeddings + a templated placeholder answer, no
# network calls, no cost, no key required. Set it to switch both the
# embedding and chat-answer functions to real OpenAI API calls.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.6-sol
